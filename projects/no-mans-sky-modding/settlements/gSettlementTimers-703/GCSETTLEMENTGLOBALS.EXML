<?xml version="1.0" encoding="utf-8"?>
<!--
  gSettlement Timers - Instant
  Original by Gumsk (nexusmods.com/nomanssky/mods/2067), built with MBINCompiler 5.71.0.1

  Rebuilt for No Man's Sky 7.03.1 build 25351301.

  The original supplies a 14-entry SettlementBuildingTimes list. In 7.03 that
  list has 63 entries and the real buildings sit at rows 36-59, so the original
  14 land on unused padding and building upgrades are unaffected. Verified: a
  Farm Module read 1:33:12 in game, and row 48 (UI_SETTLE_BUILD_FARM_SUB) is
  5600 seconds = 1:33:20.

  This file supplies all 63 rows, taken from the game's own current table, with
  every non-zero timer set to 1 second and every zero left alone.

  Deliberately NOT changed: AlertCycleDurationInSeconds (3400) and
  BugAttackCycleDurationInSeconds (9000). Those control how often the
  settlement is ATTACKED. Shortening them means constant raids.
-->
<Data template="cGcSettlementGlobals">
	<Property name="BuildingUpgradeTimeInSeconds" value="1" />
	<Property name="BuildingFreeUpgradeTimeInSeconds" value="1" />
	<Property name="JudgementWaitTimeMin" value="1" />
	<Property name="JudgementWaitTimeMax" value="1" />
	<Property name="ProductionCycleDurationInSeconds" value="1" />
	<Property name="ProductionSlotTimerOffsetInSeconds" value="1" />
	<Property name="SettlementMiniExpeditionTime" value="1" />
	<Property name="TowerRechargeTime" value="1" />
	<Property name="TowerPowerRechargeTime">
		<Property name="EarnNavigationData" value="1" />
		<Property name="ScanForBuildings" value="1" />
		<Property name="ScanForAnomalies" value="1" />
		<Property name="ScanForCrashedShips" value="1" />
	</Property>
	<Property name="SettlementBuildingTimes">
		<Property name="None" value="0" />
		<Property name="TerrainResource" value="0" />
		<Property name="Shelter" value="0" />
		<Property name="Abandoned" value="0" />
